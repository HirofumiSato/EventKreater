DATABASE_URL="postgresql://hisat@localhost:5432/event_platform_billing?schema=public"
# 結合テスト専用。開発用の event_platform_billing は書かない。
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/event_platform_billing_test?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_MONTHLY_980="price_..."
STRIPE_PRICE_ID_ONE_TIME="price_..."
NEXT_PUBLIC_APP_URL="http://localhost:3012"
FLYER_API_URL="http://127.0.0.1:8000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MAIL_WEBHOOK_URL=""
SMS_WEBHOOK_URL=""
# 郵便番号検索の上流。未設定なら zipcloud を使う。
POSTAL_CODE_API_URL="https://zipcloud.ibsnet.co.jp/api/search"
# 0円月額の終了前案内（3日前・1日前）を送るバッチの合言葉。
BILLING_NOTICE_SECRET="replace-with-a-long-random-string"

# 認証の試行回数。未設定なら括弧内の既定値を使う。正の整数だけを受け付ける。
# 照合の窓（分）の中で、メールアドレス単位に許す回数。
AUTH_ATTEMPT_LIMIT=10
# 同じ窓の中で、IP 単位に許す回数。
AUTH_ATTEMPT_IP_LIMIT=40
# 照合の窓（分）。
AUTH_ATTEMPT_WINDOW_MINUTES=15
# 1 時間あたり、会員・電話番号単位に許す送信回数。
AUTH_SEND_LIMIT=5
# 1 時間あたり、IP 単位に許す送信回数。
AUTH_SEND_IP_LIMIT=10
# 1 時間あたり、IP 単位に許す会員登録の回数。
AUTH_REGISTER_IP_LIMIT=5
# 1 時間あたり、IP 単位に許す確認コードの照合回数。
AUTH_CONFIRM_IP_LIMIT=20
# 1 つの確認コードで許す入力ミス。
AUTH_CODE_MAX_ATTEMPTS=10
# ログイン確認番号のロック時間（分）。
AUTH_LOCK_MINUTES=15

# イベント作成画面の音声入力。OpenAI の音声認識を使う。
# 未設定ならマイクボタンは「利用できません」と出て、手入力に戻る。
OPENAI_API_KEY=""
# 認識モデル。空なら gpt-4o-mini-transcribe。
VOICE_TRANSCRIBE_MODEL=""
# 1 時間あたり、接続元（IP）ごとに許す音声認識の回数。
VOICE_TRANSCRIBE_LIMIT=40
# 回数を数える窓（分）。
VOICE_TRANSCRIBE_WINDOW_MINUTES=60
# 1 にすると OpenAI を呼ばず、欄の入力例を認識結果として返す（開発用）。
# NODE_ENV=production では常に無効。録音そのものは行うためマイクは要る。
VOICE_TRANSCRIBE_MOCK=0
